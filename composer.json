{
  "name": "twotech/computer-service",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.29",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "scripts": { "dev": "concurrently -c \"#93c5fd,#fcd34d\" \"php artisan serve\" \"npm run dev\"", "build": "npm run build" },
  "minimum-stability": "stable",
  "prefer-stable": true
}
